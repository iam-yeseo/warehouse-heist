{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "warehouse-heist",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "REWARDS_DB",
      "database_name": "warehouse-heist-rewards",
      "database_id": "6748a287-a6f7-4bfa-9ada-399ce5880c18",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [
    { "name": "SESSION_RATE_LIMITER", "namespace_id": "2026091701", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "2026091702", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
